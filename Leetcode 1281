class Solution {
    public int subtractProductAndSum(int n) {

        int product = 1;  // because multiplying
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;   // get last digit
            product = product * digit;
            sum = sum + digit;
            n = n / 10;           // remove last digit
        }

        return product - sum;
    }
}
